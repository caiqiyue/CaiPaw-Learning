# ============================================================
# CaiPaw-Learning — 环境变量模板（★ 这个文件要入库）
# ============================================================
# 用法：复制成 .env，然后填真值。
#
#     cp .env.example .env          # macOS / Linux / git-bash
#     copy .env.example .env        # Windows cmd
#
# ⚠️ **只填 .env，不要在这里填真值。**
#    真值进了 Git 就永久留在历史里了，删文件再提交也删不掉，
#    得改写历史 + 强推。硬约束 E2，且有 .githooks/pre-commit 兜底。
# ============================================================

# ---- 模型访问 ----
# 开发期走外部 API；后期换自建推理服务时**只改这三行**，代码不动（硬约束 E7）。
LLM_API_KEY=sk-REPLACE_ME

# 服务商的 OpenAI 兼容端点。不同服务商不同，以控制台文档为准。
LLM_BASE_URL=https://api.deepseek.com

# 模型名。切换推理服务时改这里。
LLM_MODEL=deepseek-chat


# ============================================================
# 以下【阶段 B/C】才用到，现在留空即可 —— 别提前配
# ============================================================

# # ---- 子系统 ② 数据库（阶段 C）----
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=caipaw
# MYSQL_USER=caipaw
# MYSQL_PASSWORD=
#
# # ---- 子系统 ② 缓存（阶段 C）----
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
